#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

/*
 * XS/S layout, trackball on the right (central). Mapped after the KobitoKey layout (US-layout OS).
 * Layers: 0 default / 1 numbers+arrows (hold right thumb Enter) / 2 Bluetooth+F-keys (hold left thumb Space)
 *         3 auto-mouse (activated by trackball) / 4 scroll (hold P on layer 0; the key right of R-Click (same P position) on layer 3)
 * Eisuu is pos 44 (right of B), Kana is pos 45 (next to the right thumbs); the keys at pos 61/62 are replaced by the trackball.
 * Positions follow the L-layout numbering; the S/XS position map drops unused ones.
 */

/ {
    /* scroll axis snap: only the dominant axis (vertical or horizontal) passes; a 150 ms pause releases the lock */
    axis_snap: axis_snap {
        compatible = "zmk,input-processor-axis-snap";
        #input-processor-cells = <0>;
        idle-ms = <150>;
        decide-threshold = <4>;
        switch-ratio = <3>;
    };

    /* auto-mouse: like zip_temp_layer, but click keys / modifiers don't cancel the layer, and clicks extend it */
    auto_mouse: auto_mouse {
        compatible = "zmk,input-processor-temp-layer-ext";
        #input-processor-cells = <2>;
        excluded-positions = <19 20 21 22 53 55 56 57 58 63 64>;
        /* clicking restarts the hold timer, so repeated clicks do not fall back to layer 0 */
        extend-positions = <19 20 21>;
    };

    /* layer 0 only: simultaneous-press macros (ignored while typing quickly) */
    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>; /* Q + W */
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <25 26>; /* A + S */
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none &none &none &none &none &none &none &none &none &none &none &none
&none &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &lt 4 P &none
&none &kp A &kp S &kp D &kp F &kp G &none &none &kp H &kp J &kp K &kp L &kp SEMI &none
&none &kp Z &kp X &kp C &kp V &kp B &kp LANGUAGE_2 &kp LANGUAGE_1 &kp N &kp M &kp COMMA &kp DOT &kp SQT &none
&none &kp LSHFT &kp TAB &kp LGUI &kp LALT &lt 2 SPACE &kp LCTRL &kp BSPC &lt 1 RET &none &none &none &kp ESC &none
            >;
        };

        layer_1 {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &kp N0 &kp N1 &kp N2 &kp N3 &none &kp MINUS &none &kp UP &none &none &trans
&trans &kp EQUAL &kp N4 &kp N5 &kp N6 &none &trans &trans &kp LS(EQUAL) &kp LEFT &kp DOWN &kp RIGHT &none &trans
&trans &none &kp N7 &kp N8 &kp N9 &none &none &none &kp LS(N8) &kp FSLH &kp LBKT &kp RBKT &none &trans
&trans &kp LSHFT &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        layer_2 {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &trans
&trans &none &none &none &none &bt BT_CLR &trans &trans &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &trans
&trans &none &none &none &none &bt BT_CLR_ALL &none &none &kp F11 &kp F12 &none &none &none &trans
&trans &trans &trans &trans &trans &trans &trans &kp DEL &trans &trans &trans &trans &trans &trans
            >;
        };

        layer_3_automouse {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &mkp MCLK &mkp LCLK &mkp RCLK &mo 4 &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &kp LSHFT &trans &kp LGUI &kp LALT &trans &kp LCTRL &trans &trans &trans &trans &to 0 &trans &trans
            >;
        };

        layer_4_scroll {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &mkp MCLK &mkp LCLK &mkp RCLK &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &kp LSHFT &trans &kp LGUI &kp LALT &trans &kp LCTRL &trans &trans &trans &trans &to 0 &trans &trans
            >;
        };
    };
};

&pointing_listener {
    /* ball movement -> cursor, and enable layer 3 (auto-mouse) for 600 ms */
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
                        &auto_mouse 3 1000>;

    /* while layer 4 is active, ball movement becomes scrolling */
    scroller {
        layers = <4>;
        input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
                            &axis_snap
                            &zip_xy_to_scroll_mapper
                            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                            &zip_scroll_scaler 1 6>;
    };
};
